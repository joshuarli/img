#!/usr/bin/env python3
from pathlib import Path
import hashlib
import os
import subprocess
import sys
import tempfile
import time

if len(sys.argv) != 2:
    raise SystemExit('usage: benchmark-build-cost BASELINE_CHECKOUT')
root = Path(__file__).resolve().parent.parent
baseline = Path(sys.argv[1]).resolve()
scratch = Path(tempfile.mkdtemp(prefix='build-final-', dir=root / '.work/tmp'))
environment = dict(os.environ, TMPDIR=str(root / '.work/tmp'), RUSTC_WRAPPER='kache', CARGO_BUILD_JOBS='1')
subprocess.run(['perf-gate-ready'], check=True)
with (scratch / 'samples.tsv').open('w') as samples:
    for run in range(5):
        for side in (['oracle', 'current'] if run % 2 == 0 else ['current', 'oracle']):
            source = baseline if side == 'oracle' else root
            revision = subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip()
            target = scratch / f'{side}-{run}'
            if target.exists():
                raise RuntimeError('clean-target measurement requires a fresh directory')
            child_environment = dict(environment, CARGO_TARGET_DIR=str(target))
            for state in ['cleanTarget', 'cachedTarget']:
                command = ['cargo', 'build', '--manifest-path', str(source / 'Cargo.toml'), '--locked', '--profile', 'dist', '--features', 'build-binary']
                with (scratch / f'{side}-{run}-{state}.log').open('wb') as log:
                    started = time.perf_counter_ns()
                    subprocess.run(command, env=child_environment, stdout=log, stderr=subprocess.STDOUT, check=True)
                    elapsed = time.perf_counter_ns() - started
                binary = target / 'dist/img'
                version = subprocess.check_output([str(binary), '--version'])
                if not version.startswith(b'img '):
                    raise RuntimeError('built artifact did not run')
                digest = hashlib.sha256(binary.read_bytes()).hexdigest()
                samples.write('\t'.join(map(str, [run, side, state, elapsed, binary.stat().st_size, digest, revision])) + '\n')
                samples.flush()
subprocess.run(['perf-gate-ready', '-1'], check=True)
print('20 successful builds; five interleaved runs per side/state; pre/post gates passed')
print(scratch)

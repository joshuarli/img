#!/usr/bin/env python3
"""One entrypoint for img's performance workloads. See docs/BENCHMARKS.md.

scripts/bench list
scripts/bench check [SELECTORS]
scripts/bench build [--base REV]
scripts/bench run [SELECTORS] [--split dev|holdout] [--dry-run] [--confirm-full]
scripts/bench profile [--binary new|base] [--base REV] -- IMG ARGS...

SELECTORS: --tier edit|change|scenario|full (ceiling, default change), --only NAME,...,
--area AREA,..., --skip NAME,..., --base REV (default origin/master).
BENCH_VERIFIER pins the output verifier (default: verify built from this checkout, applied to every tool alike).
--split holdout runs the corpus workloads on the held-out originals instead of the development split. Holdout is for
qualifying a frozen candidate, never for tuning."""
import argparse, datetime, hashlib, json, os, pathlib, shutil, subprocess, sys, time

ROOT = pathlib.Path(__file__).resolve().parent.parent
SHARED = pathlib.Path(subprocess.run(['git', 'rev-parse', '--path-format=absolute', '--git-common-dir'], cwd=ROOT, capture_output=True, text=True, check=True).stdout.strip()).parent
WORK = SHARED / '.work/bench'
CORPUS = pathlib.Path(os.environ.get('BENCH_CORPUS', SHARED / '.work/qcorpus'))
MANIFEST = ROOT / 'benchmarks/corpus/qualification/manifest.json'
TIERS = ['edit', 'change', 'scenario', 'full']
NEW_BIN = ROOT / 'target/dist/img'
SOURCES = ['src', 'vendor', 'codecs', 'Cargo.toml', 'Cargo.lock', 'build.rs']
UNSUPPORTED = {'photo-06.jpg', 'photo-07.jpg', 'photo-09.jpg', 'photo-12.jpg', 'photo-13.jpg'}
SET_PICKS = {
    'smoke': [('photo', 'jpeg', 'medium', {}), ('ui-text', 'png', 'medium', {}), ('synthetic', 'png', 'medium', {'alpha': True}),
              ('grayscale', 'png', 'medium', {}), ('texture', 'png', 'thumb', {})],
}
SET_PICKS['scenario'] = SET_PICKS['smoke'] + [
    ('photo', 'jpeg', 'large', {}), ('photo', 'jpeg', 'xlarge', {}), ('grayscale', 'jpeg', 'large', {}),
    ('texture', 'jpeg', 'xlarge', {}), ('ui-text', 'jpeg', 'medium', {}), ('synthetic', 'png', 'icon', {'alpha': True}),
    ('synthetic', 'png', 'medium', {'bit_depth': 16})]
DECODE = WORK / 'decode'
JPEG_SCRATCH, AVIF_SCRATCH, PNG_QUALIFY = DECODE / 'jpeg', DECODE / 'avif', DECODE / 'png'
LOOPS = WORK / 'loops'
VERIFIER = pathlib.Path(os.environ.get('BENCH_VERIFIER', LOOPS / 'target-img/release/verify'))


SPLIT = 'dev'


def corpus_set(name, split=None):
    split = split or SPLIT
    sources = [s for s in json.loads(MANIFEST.read_text())['sources'] if s['split'] == split and s['file'] not in UNSUPPORTED]
    if name == 'dev' or split == 'holdout':
        return [s['file'] for s in sources]
    picked = []
    for cls, fmt, size, extra in SET_PICKS[name]:
        match = next(s for s in sources if s['class'] == cls and s['format'] == fmt and s['size_class'] == size
                     and all(s[k] == v for k, v in extra.items()) and s['file'] not in picked)
        picked.append(match['file'])
    return picked


def base_bin(ctx): return WORK / 'bin' / f'img-{ctx.base_sha}'
def base_tree(ctx): return SHARED / '.work/wt' / f'bench-base-{ctx.base_sha[:12]}'
def py(script, *args): return ['python3', str(ROOT / script), *map(str, args)]


def workflow(name, area, purpose, formats, scores, levels, costs):
    def command(ctx, level, out):
        files, rounds, effort = levels[level]
        env = {'WORKFLOW_FORMATS': formats, 'WORKFLOW_SCORES': scores, 'WORKFLOW_VERIFIER': str(VERIFIER)}
        run = py('benchmarks/codecs/workflow.py', out / 'run.json', rounds, effort, f'new={NEW_BIN}', f'base={base_bin(ctx)}', '--',
                 *[CORPUS / f for f in corpus_set(files)])
        return [loops(ctx), (env, run), ({}, py('benchmarks/codecs/workflow-report.py', out / 'run.json', 'new', 'base'))]
    return dict(name=name, area=area, purpose=purpose, levels=levels, costs=costs, needs=['new', 'base', 'base-tree', 'corpus', 'gate'], command=command)


def batch_command(ctx, level, out):
    files, rounds, modes, jobs = BATCH_LEVELS[level]
    sets = WORK / 'sets' / files
    link = 'import os,shutil,sys\nd=sys.argv[1]; shutil.rmtree(d, ignore_errors=True); os.makedirs(d)\nfor f in sys.argv[2:]: os.link(f, os.path.join(d, os.path.basename(f)))'
    steps = [loops(ctx), ({}, ['python3', '-c', link, sets, *[CORPUS / f for f in corpus_set(files) if f.endswith('.png')]])]
    for mode in modes:
        steps.append(({'BATCH_VERIFIER': str(VERIFIER)}, py('benchmarks/codecs/batch.py', out / f'{mode}.json', rounds, sets, mode, f'new={NEW_BIN}', f'base={base_bin(ctx)}', '--', *jobs)))
    return steps


BATCH_LEVELS = {'change': ('dev', 3, ['lossless'], [4]), 'scenario': ('dev', 3, ['lossless', 'jpeg90'], [1, 4])}


def loops(ctx):
    return ({'IMG_BASE': str(base_tree(ctx)), 'LOOPS_SCRATCH': str(LOOPS)}, ['sh', str(ROOT / 'benchmarks/codecs/loops-build.sh')])


def score_exact(ctx, level, out):
    sources = {s['file']: s for s in json.loads(MANIFEST.read_text())['sources']}
    specs = [f'{f}:{"webp" if sources[f]["alpha"] else "jpeg"}' for f in corpus_set('smoke')]
    return [loops(ctx), ({}, py('benchmarks/codecs/score/score-exact.py', out, base_bin(ctx), LOOPS / 'target-img/release/score-loop',
                                 LOOPS / 'target-base/release/score-loop', CORPUS, *specs))]


def png_encode(ctx, level, out):
    files, rounds = {'change': ('smoke', 1), 'scenario': ('scenario', 5)}[level]
    pngs = [CORPUS / f for f in corpus_set(files) if f.endswith('.png')]
    return [loops(ctx), ({}, py('benchmarks/codecs/png/encode-paired.py', out / 'run.json', rounds, f'new={LOOPS}/target-img/release/png-encode-loop',
                                 f'base={LOOPS}/target-base/release/png-encode-loop', '--', *pngs)),
            ({}, py('benchmarks/codecs/png/encode-report.py', out / 'run.json', 'new', 'base'))]


def decode_jpeg(ctx, level, out):
    return [({'JPEG_SCRATCH': str(JPEG_SCRATCH), 'IMG_BASE': str(base_tree(ctx))}, ['sh', str(ROOT / 'benchmarks/codecs/jpeg/decode-build.sh')]),
            ({}, py('benchmarks/codecs/jpeg/decode-qualify.py', JPEG_SCRATCH / 'fixtures', out / 'run.json', 9,
                    f'new={JPEG_SCRATCH}/decode-loop-target/release/jpeg-decode-loop:img',
                    f'base={JPEG_SCRATCH}/decode-loop-base-target/release/jpeg-decode-loop:img')),
            ({}, py('benchmarks/codecs/jpeg/decode-report.py', out / 'run.json', 'new', 'base'))]


def decode_avif(ctx, level, out):
    q = AVIF_SCRATCH
    return [({'AVIF_SCRATCH': str(q)}, ['sh', str(ROOT / 'benchmarks/codecs/avif/decode-build.sh')]),
            ({}, py('benchmarks/codecs/avif/decode-qualify.py', q / 'fixtures', out / 'run.json', 9, q / 'img-target/release/avif-qual-img',
                    q / 'qual-dav1d-target/release/avif-qual-dav1d', q / 'qual-zen-target/release/avif-qual-zen')),
            ({}, py('benchmarks/codecs/avif/decode-report.py', out / 'run.json'))]


def decode_png(ctx, level, out):
    binary = PNG_QUALIFY / 'target/release/png-decode-loop'
    return [({}, py('benchmarks/codecs/png/decode-check.py', PNG_QUALIFY / 'fixtures', binary)),
            ({}, py('benchmarks/codecs/png/decode-qualify.py', PNG_QUALIFY / 'fixtures', out / 'run.json', 9,
                    *[f'{d}={binary}:{d}' for d in ('png', 'zen', 'spng', 'libpng')]))]


def harness(ctx, level, out):
    scripts = sorted(str(p) for p in (ROOT / 'benchmarks').rglob('*.py')) + [str(ROOT / 'scripts/bench')]
    return [({}, ['python3', '-c', 'import sys\nfor p in sys.argv[1:]: compile(open(p).read(), p, "exec")', *scripts]),
            ({'PYTHONDONTWRITEBYTECODE': '1'}, ['python3', '-m', 'unittest', '-q', 'tests.test_bench'])]


WORKLOADS = [
    dict(name='harness', area='meta', purpose='benchmark scripts compile; selection and preflight rules hold',
         levels={'edit': None}, costs={'edit': '1 s observed'}, needs=[], command=harness),
    dict(name='png-encode', area='png', purpose='in-process lossless PNG encode time and bytes at every effort, exactness checked',
         levels={'change': None, 'scenario': None}, costs={'change': 'est. 30 s warm', 'scenario': 'est. 15 min'},
         needs=['base-tree', 'corpus', 'gate'], command=png_encode),
    dict(name='score-exact', area='score', purpose='SSIMULACRA2 scores stay bit-identical to base; per-score time',
         levels={'change': None}, costs={'change': '5 s observed warm, 2.5 min with a cold score-loop build'}, needs=['base', 'base-tree', 'corpus'], command=score_exact),
    workflow('workflow-scored', 'workflow', 'complete optimize --score: wall, CPU, peak RSS, bytes, output identity vs base',
             'jpeg,png,avif', '90', {'change': ('smoke', 1, 'balanced'), 'scenario': ('scenario', 5, 'balanced')},
             {'change': '41 s observed', 'scenario': 'est. 60 min'}),
    workflow('workflow-lossless', 'png', 'complete PNG --lossless optimize: wall, CPU, peak RSS, bytes vs base',
             'png', 'lossless', {'change': ('smoke', 1, 'balanced'), 'scenario': ('scenario', 5, 'best')},
             {'change': '1 s observed', 'scenario': 'est. 20 min'}),
    dict(name='batch', area='batch', purpose='multi-image throughput and peak RSS under -j', levels=BATCH_LEVELS, costs={'change': '4 s observed (3 rounds)', 'scenario': 'est. 30 min'},
         needs=['new', 'base', 'base-tree', 'corpus', 'gate'], command=batch_command),
    dict(name='jpeg-decode', area='decode', purpose='in-process JPEG decode time and RSS vs base on qualification fixtures',
         levels={'scenario': None}, costs={'scenario': 'est. 30 min (9 gated rounds)'}, needs=['gate', 'base-tree', 'jpeg-decode'], command=decode_jpeg),
    dict(name='avif-decode', area='decode', purpose='AVIF decode vs dav1d and Zen (library qualification)',
         levels={'full': None}, costs={'full': 'est. 60 min (9 gated rounds)'}, needs=['gate', 'avif-decode'], command=decode_avif),
    dict(name='png-decode', area='decode', purpose='png crate vs libspng, libpng and Zen (library qualification)',
         levels={'full': None}, costs={'full': 'est. 60 min (9 gated rounds)'}, needs=['gate', 'png-decode'], command=decode_png),
    dict(name='historical', area='workflow', purpose='recorded historical workflow suite (make benchmark-run)',
         levels={'full': None}, costs={'full': 'est. hours'}, needs=['gate'], command=lambda ctx, level, out: [({}, ['make', '-C', str(ROOT), 'benchmark-run'])]),
]
NAMES = {w['name'] for w in WORKLOADS}
AREAS = {w['area'] for w in WORKLOADS}


def level_for(workload, ceiling):
    eligible = [t for t in TIERS[:TIERS.index(ceiling) + 1] if t in workload['levels']]
    return eligible[-1] if eligible else None


def select(tier, only=(), areas=(), skip=()):
    for kind, values, known in (('workload', only, NAMES), ('area', areas, AREAS), ('workload', skip, NAMES)):
        unknown = sorted(set(values) - known)
        if unknown:
            raise SystemExit(f'unknown {kind}: {", ".join(unknown)} (known: {", ".join(sorted(known))})')
    chosen, excluded = [], []
    for w in WORKLOADS:
        if only and w['name'] not in only or areas and w['area'] not in areas:
            continue
        if w['name'] in skip:
            excluded.append((w['name'], 'skipped by --skip'))
        elif (level := level_for(w, tier)) is None:
            excluded.append((w['name'], f'lowest tier {min(w["levels"], key=TIERS.index)} is above the --tier {tier} ceiling'))
        else:
            chosen.append((w, level))
    if not chosen:
        raise SystemExit('selection matched no runnable workload: ' + '; '.join(f'{n}: {r}' for n, r in excluded))
    return chosen, excluded


def newest_source_mtime():
    listed = subprocess.run(['git', 'ls-files', '-z', '-co', '--exclude-standard', *SOURCES], cwd=ROOT, capture_output=True, check=True).stdout
    return max((ROOT / p).stat().st_mtime for p in listed.decode().split('\0') if p and (ROOT / p).exists())


def check(ctx, chosen):
    problems, warnings = [], []
    needs = {}
    for w, _ in chosen:
        for need in w['needs']:
            needs.setdefault(need, []).append(w['name'])
    def fail(need, problem, fix): problems.append(f'{problem}\n    fix: {fix}\n    needed by: {", ".join(needs[need])}')
    for tool in ('python3', 'git', 'cargo'):
        if not shutil.which(tool):
            problems.append(f'{tool} not on PATH')
    if 'gate' in needs and not shutil.which('perf-gate-ready'):
        fail('gate', 'perf-gate-ready not on PATH', 'install the host gate tool')
    if 'new' in needs:
        if not NEW_BIN.exists():
            fail('new', f'{NEW_BIN} missing', 'scripts/bench build')
        elif NEW_BIN.stat().st_mtime < newest_source_mtime():
            fail('new', f'{NEW_BIN} is older than the sources', 'scripts/bench build')
    if 'base' in needs and not base_bin(ctx).exists():
        fail('base', f'base binary for {ctx.base} ({ctx.base_sha[:12]}) missing', f'scripts/bench build --base {ctx.base}')
    if 'base-tree' in needs and not base_tree(ctx).exists():
        fail('base-tree', f'base worktree {base_tree(ctx)} missing', f'scripts/bench build --base {ctx.base}')
    if 'corpus' in needs:
        files = sorted({f for name in ('smoke', 'scenario', 'dev') for f in corpus_set(name)})
        hashes = {s['file']: s['sha256'] for s in json.loads(MANIFEST.read_text())['sources']}
        bad = [f for f in files if not (CORPUS / f).exists() or hashlib.sha256((CORPUS / f).read_bytes()).hexdigest() != hashes[f]]
        if bad:
            fail('corpus', f'{len(bad)} qualification corpus files missing or changed in {CORPUS} (first: {bad[0]})',
                 f'python3 -I scripts/qualification-corpus {CORPUS}')
    prepare = lambda fmt: (f'benchmarks/codecs/decode-prepare {fmt} {DECODE} --corpus {CORPUS} --img {NEW_BIN}'
                           + (f' --base-checkout {base_tree(ctx)}' if fmt == 'jpeg' else ''))
    for need, paths in (
        ('jpeg-decode', [JPEG_SCRATCH / 'fixtures/manifest.json', JPEG_SCRATCH / 'turbo-build/cjpeg-static']),
        ('avif-decode', [AVIF_SCRATCH / 'fixtures/manifest.json', AVIF_SCRATCH / 'avifcodec']),
        ('png-decode', [PNG_QUALIFY / 'fixtures/manifest.json', PNG_QUALIFY / 'target/release/png-decode-loop'])):
        missing = [p for p in paths if not p.exists()]
        if need in needs and missing:
            fail(need, f'{missing[0]} missing', prepare(need.split('-')[0]))
    if 'png-decode' in needs:
        warnings.append('png-decode qualifies libraries, not img; its harness is not rebuilt per run')
    free = shutil.disk_usage(ROOT).free
    if free < 5 << 30:
        problems.append(f'only {free >> 30} GiB free; workloads write outputs under .work/bench')
    leftover = subprocess.run(['pgrep', '-fl', r'^(\S*/)?python3?(\.[0-9]+)? \S*(workflow|batch|decode-qualify|encode-paired)\.py |^\S*/img(-[0-9a-f]{40})? (optimize|convert) '],
                              capture_output=True, text=True).stdout.strip()
    if leftover:
        problems.append(f'benchmark processes already running:\n    {leftover}\n    fix: wait for or stop them')
    host = subprocess.run(['perf-gate-ready'], capture_output=True, text=True) if shutil.which('perf-gate-ready') else None
    info = f'host gate: {"ready" if host and host.returncode == 0 else "not ready (gated workloads will wait)" if host else "unavailable"}'
    return problems, warnings, info


class Context:
    def __init__(self, base):
        self.base = base
        try:
            self.base_sha = subprocess.run(['git', 'rev-parse', '--verify', f'{base}^{{commit}}'], cwd=ROOT, capture_output=True, text=True, check=True).stdout.strip()
        except subprocess.CalledProcessError:
            raise SystemExit(f'--base {base} is not a commit')


def build(ctx):
    env = {**os.environ, 'CARGO_BUILD_JOBS': os.environ.get('CARGO_BUILD_JOBS', '4')}
    cargo = ['cargo', 'build', '--locked', '--profile', 'dist', '--features', 'build-binary']
    subprocess.run(cargo, cwd=ROOT, env=env, check=True)
    tree = base_tree(ctx)
    if not tree.exists():
        subprocess.run(['git', 'worktree', 'add', '--detach', str(tree), ctx.base_sha], cwd=ROOT, check=True)
    if not base_bin(ctx).exists():
        subprocess.run(cargo, cwd=tree, env=env, check=True)
        base_bin(ctx).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(tree / 'target/dist/img', base_bin(ctx))
    print(f'new {NEW_BIN}\nbase {base_bin(ctx)} ({ctx.base_sha[:12]}, worktree {tree})')


def git(*args): return subprocess.run(['git', *args], cwd=ROOT, capture_output=True, text=True).stdout.strip()
def sha256(path): return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest() if pathlib.Path(path).exists() else None


def run(ctx, chosen, excluded, tier, dry):
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    out_root = WORK / 'runs' / (f'{stamp}-{tier}' + ('-holdout' if SPLIT == 'holdout' else ''))
    plan = [(w, level, out_root / w['name'], w['command'](ctx, level, out_root / w['name'])) for w, level in chosen]
    for name, reason in excluded:
        print(f'excluded {name}: {reason}')
    if dry:
        for w, level, out, steps in plan:
            print(f'# {w["name"]} ({level}): {w["purpose"]}')
            for env, cmd in steps:
                print(' '.join([*(f'{k}={v}' for k, v in env.items()), *map(str, cmd)]))
        return 0
    summary = dict(started=stamp, tier=tier, split=SPLIT, commit=git('rev-parse', 'HEAD'), dirty=bool(git('status', '--porcelain', '--', *SOURCES)),
                   base=ctx.base, base_sha=ctx.base_sha, new_binary_sha256=sha256(NEW_BIN), base_binary_sha256=sha256(base_bin(ctx)),
                   corpus_manifest_sha256=sha256(MANIFEST), excluded=[dict(name=n, reason=r) for n, r in excluded], workloads=[])
    failed = False
    for w, level, out, steps in plan:
        out.mkdir(parents=True, exist_ok=True)
        start, status = time.monotonic(), 0
        with open(out / 'log.txt', 'w') as log:
            for env, cmd in steps:
                log.write('$ ' + ' '.join(map(str, cmd)) + '\n'); log.flush()
                status = subprocess.run(list(map(str, cmd)), cwd=ROOT, env={**os.environ, **env}, stdout=log, stderr=subprocess.STDOUT).returncode
                if status:
                    break
        validity, verdicts = [], []
        for result in sorted(out.glob('*.json')):
            doc = json.loads(result.read_text())
            if result.name.endswith('.verdict.json'):
                verdicts += doc
            elif isinstance(doc, dict) and 'discarded_rounds' in doc:
                validity.append(f'{result.name}: {doc.get("rounds")} rounds kept, {doc["discarded_rounds"]} discarded for host load'
                                + ('' if doc.get('gated', True) else ', ungated'))
        statuses = {v['status'] for v in verdicts}
        undisposed = sum(len(v.get('undisposed', [])) for v in verdicts)
        budget = ('no budget' if not verdicts else 'regression' if 'regression' in statuses else f'{undisposed} undisposed' if undisposed
                  else 'inconclusive' if 'inconclusive' in statuses else 'within budget')
        outcome = 'ok' if status == 0 else 'regression' if status == 3 else 'FAIL'
        record = dict(name=w['name'], level=level, exit=status, outcome=outcome, budget=budget, verdicts=verdicts,
                      seconds=round(time.monotonic() - start, 1), validity=validity, log=str(out / 'log.txt'))
        summary['workloads'].append(record)
        failed |= status != 0
        print(f'{outcome:10} {w["name"]:18} {level:9} {record["seconds"]:8.1f}s  {budget:13}  {"; ".join(validity) or "no timing rounds"}')
        for v in verdicts:
            if v['status'] != 'within' or v.get('undisposed'):
                print(f'    {v["metric"]}: {v["status"]} geomean {v["geomean"]} CI {v["ci"]} budget {v["budget"]}'
                      + (f'; undisposed over {len(v["undisposed"])}: {", ".join(v["undisposed"][:5])}' if v.get('undisposed') else ''))
    summary['verdict'] = ('budgets in benchmarks/budgets.json; "within budget" needs every metric CI at or below its budget, '
                          'single-round tiers are often inconclusive; workloads without a budget only prove completion')
    (out_root / 'summary.json').write_text(json.dumps(summary, indent=1))
    print(f'{summary["verdict"]}\nsummary {out_root / "summary.json"}')
    return 1 if failed else 0


def profile(ctx, which, args):
    tree = ROOT if which == 'new' else base_tree(ctx)
    binary = tree / 'target/release/img'
    if not binary.exists() or (which == 'new' and binary.stat().st_mtime < newest_source_mtime()):
        raise SystemExit(f'{binary} missing or stale; profiles need symbols: cargo build --release --features build-binary (in {tree})')
    out = WORK / 'profiles' / datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    out.mkdir(parents=True)
    command, started = [str(binary), *args], time.monotonic()
    if sys.platform == 'darwin':
        child = subprocess.Popen(command, cwd=out)
        sampler = subprocess.Popen(['sample', str(child.pid), '600', '1', '-mayDie', '-f', str(out / 'sample.txt')],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        status = child.wait(); sampler.wait()
        text = (out / 'sample.txt').read_text(errors='replace') if (out / 'sample.txt').exists() else ''
        top = text[text.find('Sort by top of stack'):].split('\n\n')[0]
    elif shutil.which('perf'):
        status = subprocess.run(['perf', 'record', '-g', '-o', str(out / 'perf.data'), '--', *command], cwd=out).returncode
        top = subprocess.run(['perf', 'report', '-i', str(out / 'perf.data'), '--no-children', '--stdio', '--percent-limit', '1'],
                             capture_output=True, text=True).stdout
    else:
        raise SystemExit('profiling needs macOS sample or Linux perf')
    (out / 'top.txt').write_text(top)
    if top.count('\n') < 2:
        top = (f'no samples captured: the run lasted {time.monotonic() - started:.2f} s. Profile a larger input, or the '
               'in-process loops (.work/bench/loops/target-*/release/score-loop, png-encode-loop) which repeat the work.')
    print(top[:4000])
    print(f'exit {status}; profile in {out}')
    return status


def main(argv=None):
    parser = argparse.ArgumentParser(prog='scripts/bench', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('command', choices=['list', 'check', 'build', 'run', 'profile'])
    parser.add_argument('--binary', choices=['new', 'base'], default='new')
    parser.add_argument('img_args', nargs='*')
    parser.add_argument('--tier', choices=TIERS, default='change')
    split = lambda s: [x for x in s.split(',') if x]
    parser.add_argument('--only', type=split, default=[])
    parser.add_argument('--area', type=split, default=[])
    parser.add_argument('--skip', type=split, default=[])
    parser.add_argument('--base', default=os.environ.get('BENCH_BASE', 'origin/master'))
    parser.add_argument('--split', choices=['dev', 'holdout'], default='dev')
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--confirm-full', action='store_true')
    a = parser.parse_args(argv)
    if a.command == 'list':
        for w in WORKLOADS:
            print(f'{w["name"]:18} area={w["area"]:9} tiers={"; ".join(f"{t} {c}" for t, c in w["costs"].items())}\n    {w["purpose"]}')
        return 0
    global SPLIT
    SPLIT = a.split
    ctx = Context(a.base)
    if a.command == 'build':
        build(ctx)
        return 0
    if a.command == 'profile':
        if not a.img_args:
            raise SystemExit('profile needs img arguments after --')
        return profile(ctx, a.binary, a.img_args)
    if a.tier == 'full' and a.command == 'run' and not a.dry_run and not a.confirm_full:
        raise SystemExit('--tier full is manual-only: pass --confirm-full when the full suite was explicitly requested')
    chosen, excluded = select(a.tier, a.only, a.area, a.skip)
    problems, warnings, info = check(ctx, chosen)
    print(info)
    for w in warnings:
        print('warning:', w)
    for p in problems:
        print('problem:', p)
    if problems and not a.dry_run:
        print('preflight failed; nothing ran')
        return 2
    print(f'preflight {"failed (dry run continues)" if problems else "ok"} for: {", ".join("{}({})".format(w["name"], level) for w, level in chosen)}')
    if a.command == 'check':
        return 0
    return run(ctx, chosen, excluded, a.tier, a.dry_run)


if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/env python3
import collections
import hashlib
import json
import os
import pathlib
import struct
import sys
import time
import urllib.error
import urllib.request
import zlib

ROOT = pathlib.Path(__file__).resolve().parent.parent
MANIFEST = ROOT / 'benchmarks/corpus/qualification/manifest.json'
AGENT = 'img-benchmark-corpus/1.0 (https://github.com/joshuarli/img)'
FONT = {
 'A': '01110100011000111111100011000110001', 'B': '11110100011000111110100011000111110',
 'C': '01111100001000010000100001000001111', 'D': '11110100011000110001100011000111110',
 'E': '11111100001000011110100001000011111', 'F': '11111100001000011110100001000010000',
 'G': '01111100001000010111100011000101111', 'H': '10001100011000111111100011000110001',
 'I': '11111001000010000100001000010011111', 'J': '00111000100001000010100101001001100',
 'K': '10001100101010011000101001001010001', 'L': '10000100001000010000100001000011111',
 'M': '10001110111010110101100011000110001', 'N': '10001110011010110011100011000110001',
 'O': '01110100011000110001100011000101110', 'P': '11110100011000111110100001000010000',
 'Q': '01110100011000110001101011001001101', 'R': '11110100011000111110101001001010001',
 'S': '01111100001000001110000010000111110', 'T': '11111001000010000100001000010000100',
 'U': '10001100011000110001100011000101110', 'V': '10001100011000110001100010101000100',
 'W': '10001100011000110101101011101110001', 'X': '10001100010101000100010101000110001',
 'Y': '10001100010101000100001000010000100', 'Z': '11111000010001000100010001000011111',
 '0': '01110100011001110101110011000101110', '1': '00100011000010000100001000010001110',
 '2': '01110100010000100010001000100011111', '3': '11110000010000101110000010000111110',
 '4': '00010001100101010010111110001000010', '5': '11111100001000011110000010000111110',
 '6': '01110100001000011110100011000101110', '7': '11111000010001000100010000100001000',
 '8': '01110100011000101110100011000101110', '9': '01110100011000101111000010000101110',
}

def chunk(kind, data):
    return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data))

def generate(p):
    w, h, seed, kind, depth, alpha = (p[k] for k in ('width', 'height', 'seed', 'kind', 'bit_depth', 'alpha'))
    gray = kind == 'grayscale'
    color = 0 if gray else (6 if alpha else 2)
    rows = bytearray()
    labels = ('DASHBOARD', 'ACCOUNT', 'SALES REPORT', 'SEARCH', 'SETTINGS', 'PROJECTS', 'STATUS', 'WELCOME')
    for y in range(h):
        rows.append(0)
        for x in range(w):
            n = ((x * 374761393 + y * 668265263 + seed * 1442695041) ^ ((x + seed) * (y + 31) * 2654435761)) & 0xffffffff
            n ^= n >> 13
            if kind == 'ui-text':
                panel = y < h // 9 or x < w // 5
                c = (28 + seed % 35, 48 + seed % 55, 80 + seed % 75) if panel else (230 + seed % 20, 235 + seed % 15, 240 + seed % 10)
                tx, ty = x - w // 4, y - h // 5
                scale = max(1, min(w, h) // 128)
                if tx >= 0 and ty >= 0:
                    line = ty // (12 * scale)
                    label = labels[(line + seed) % len(labels)] + str((seed * 7 + line) % 100)
                    col, row = (tx // scale) // 6, (ty // scale) % 12
                    if col < len(label) and row < 7 and tx // scale % 6 < 5 and label[col] in FONT and FONT[label[col]][row * 5 + tx // scale % 6] == '1':
                        c = (20 + seed % 60, 70 + seed % 100, 130 + seed % 100)
            elif kind == 'texture':
                v = (n ^ (n >> 11)) & 255
                c = ((v + seed * 13) & 255, (v // 2 + x // 4 + seed * 3) & 255, (v // 3 + y // 3 + seed * 7) & 255)
            elif gray:
                c = ((x * (seed % 7 + 1) + y * (seed % 11 + 1) + (n & (31 if seed % 2 else 3))) & 255,)
            else:
                v = ((x // (seed % 13 + 2)) ^ (y // (seed % 17 + 2))) & 1
                c = ((x * 255 // max(1, w - 1) + seed * 9) & 255, (y * 255 // max(1, h - 1) + seed * 17) & 255, 220 if v else 32)
                radius = min(w, h) // 4
                distance = (x - w // 2) ** 2 + (y - h // 2) ** 2
                coverage = max(0, min(255, (radius * radius - distance) * 255 // max(1, 2 * radius) + 128))
                c = tuple((component * (255 - coverage) + target * coverage) // 255 for component, target in zip(c, (250, 220, 75)))
            if alpha:
                c += ((x * 255 // max(1, w - 1) + y + seed * 19) & 255,)
            for v in c:
                if depth == 16:
                    rows.extend(struct.pack('>H', v * 257))
                else:
                    rows.append(v)
    header = struct.pack('>IIBBBBB', w, h, depth, color, 0, 0, 0)
    return b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', header) + chunk(b'IDAT', zlib.compress(rows, 9)) + chunk(b'IEND', b'')

def headers(data):
    if data.startswith(b'\x89PNG\r\n\x1a\n'):
        w, h, depth, color = struct.unpack('>IIBB', data[16:26])
        return dict(format='png', width=w, height=h, channels={0:1,2:3,3:1,4:2,6:4}[color], bit_depth=depth, alpha=color in (4, 6) or b'tRNS' in data)
    if data[:2] == b'\xff\xd8':
        pos = 2
        while pos < len(data):
            if data[pos] != 255:
                raise ValueError('invalid JPEG marker')
            while data[pos] == 255:
                pos += 1
            marker = data[pos]
            pos += 1
            if marker in (0xd8, 0xd9, 1) or 0xd0 <= marker <= 0xd7:
                continue
            length = int.from_bytes(data[pos:pos+2], 'big')
            if marker in (0xc0, 0xc1, 0xc2):
                depth, h, w, channels = struct.unpack('>BHHB', data[pos+2:pos+8])
                return dict(format='jpeg', width=w, height=h, channels=channels, bit_depth=depth, alpha=False, jpeg_mode='progressive' if marker == 0xc2 else 'baseline' if marker == 0xc0 else 'extended')
            pos += length
    raise ValueError('unsupported image header')

def digest(data):
    return hashlib.sha256(data).hexdigest()

def fetch(url):
    for attempt in range(5):
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': AGENT}), timeout=60) as response:
                return response.read()
        except (OSError, urllib.error.URLError):
            if attempt == 4:
                raise
            time.sleep(15 * (2 ** attempt))

def main():
    if len(sys.argv) != 2:
        raise SystemExit('usage: python3 -I scripts/qualification-corpus DEST')
    dest = pathlib.Path(sys.argv[1])
    dest.mkdir(parents=True, exist_ok=True)
    entries = json.loads(MANIFEST.read_text())['sources']
    counts = collections.Counter()
    created = 0
    for entry in entries:
        path = dest / entry['file']
        if path.exists():
            data = path.read_bytes()
        else:
            if entry['source'] == 'generated':
                data = generate(entry['generator'])
            else:
                data = fetch(entry['source'])
                time.sleep(3)
            if digest(data) != entry['sha256']:
                raise ValueError(f"hash mismatch: {entry['file']}")
            path.write_bytes(data)
            created += 1
        if digest(data) != entry['sha256']:
            raise ValueError(f"hash mismatch: {entry['file']}")
        actual = headers(data)
        if any(entry.get(k) != v for k, v in actual.items()):
            raise ValueError(f"header mismatch: {entry['file']}: {actual}")
        counts[(entry['class'], entry['split'], entry['size_class'])] += 1
    for key, count in sorted(counts.items()):
        print(*key, count)
    print(f'verified {len(entries)} files; materialized {created}')

if __name__ == '__main__':
    main()

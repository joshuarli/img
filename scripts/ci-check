#!/bin/sh
set -eu
cd "$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
export TMPDIR="$PWD/.work/tmp" RUSTC_WRAPPER=kache
mkdir -p "$TMPDIR" "${CARGO_TARGET_DIR:-target}"
cargo check --locked --no-default-features
cargo check --locked --no-default-features --features build-binary
cargo clippy --locked --all-features --all-targets
if [ "$(id -u)" -eq 0 ]; then
    cargo fetch --locked
    adduser -D verifier
    chmod o+rx /root
    chown -R verifier /root/.cargo "${CARGO_TARGET_DIR:-target}" "$TMPDIR"
    KACHE_CACHE_DIR="$TMPDIR/kache-verifier" su -p verifier -s /bin/sh -c 'make test'
else
    make test
fi
